rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    match /users/{uid}/bloodPressure/{recordId} {
      allow read, delete: if owner(uid);
      allow create, update: if owner(uid)
        && request.resource.data.keys().hasAll([
          'id', 'systolic', 'diastolic', 'measuredAt', 'sourceApp',
          'sourceModifiedAt', 'unit', 'provider'
        ])
        && request.resource.data.keys().hasOnly([
          'id', 'systolic', 'diastolic', 'measuredAt', 'sourceApp',
          'sourceModifiedAt', 'unit', 'provider', 'deviceManufacturer', 'deviceModel'
        ])
        && request.resource.data.id == recordId
        && request.resource.data.systolic is number
        && request.resource.data.systolic >= 0
        && request.resource.data.systolic <= 300
        && request.resource.data.diastolic is number
        && request.resource.data.diastolic >= 0
        && request.resource.data.diastolic <= 200
        && request.resource.data.measuredAt is timestamp
        && request.resource.data.sourceModifiedAt is timestamp
        && request.resource.data.sourceApp is string
        && request.resource.data.unit == 'mmHg'
        && request.resource.data.provider == 'health_connect';
    }
    match /food/{foodId} {
      // Delete is for tool/dedupe_food.dart merging duplicate foods.
      allow read, delete: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.data.keys().hasAll([
          'food', 'alternatives', 'health_conditions', 'personal_prefs',
          'local_news', 'general_info'
        ])
        && request.resource.data.keys().hasOnly([
          'food', 'alternatives', 'health_conditions', 'personal_prefs',
          'local_news', 'general_info', 'updatedAt'
        ])
        && request.resource.data.food is string
        && request.resource.data.alternatives is list
        && request.resource.data.health_conditions is list
        && request.resource.data.personal_prefs is list
        && request.resource.data.local_news is string
        && request.resource.data.general_info is string;
    }
  }
}
